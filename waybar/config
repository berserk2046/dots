{
    "position": "top",
	"height": 22,
	"margin-left": 100,
	"margin-right": 100,
    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["custom/date" ],
    "modules-right": ["custom/profile", "custom/spotify", "mpd", "pulseaudio", "network", "custom/system", "backlight", "battery", "tray", "custom/notifications", "custom/power"],
    "hyprland/submap": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "hyprland/window": {
       "format": "{}",
       "on-click-middle": "hyprctl dispatch 'hl.dsp.window.close()'",
       "on-click": "hyprctl dispatch 'hl.dsp.window.float()'",
       "on-click-right": "hyprctl dispatch 'hl.dsp.window.move({ workspace = \"special:scratchpad\", follow = false })'",
       "on-scroll-up": "hyprctl dispatch 'hl.dsp.window.cycle_next({ next = false })'",
       "on-scroll-down": "hyprctl dispatch 'hl.dsp.window.cycle_next()'",
       "tooltip": false
    },

    "tray": {
        // "icon-size": 21,
        "spacing": 10
    },
    // CPU and RAM in one module; click for the System panel (CPU graph, memory, storage, processes).
    "custom/system": {
        "exec": "~/.config/waybar-widgets/waybar-system.sh",
        "return-type": "json",
        "on-click": "~/.config/waybar-widgets/toggle.sh system",
        "tooltip": false
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "on-scroll-up":"sudo brightnessctl s +5%",
        "on-scroll-down":"sudo brightnessctl s 5%-"
    },
    "battery": {
        "states": {
            "good": 82,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-good": "{capacity}% {icon}",
        // "format-full": "",
        "format-icons": ["b", "b", "b", "b", "b"],
        "on-click": "~/.config/waybar-widgets/toggle.sh battery",
        "tooltip": false
    },
    "network": {
        // No fixed "interface": waybar follows the default route, so Ethernet shows when plugged in.
        "format": "{ifname}",
        "format-wifi": " ",
        "format-ethernet": " ",
        "format-disconnected": "",
        "tooltip-format": "{ifname}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}  ",
        "tooltip-format-disconnected": "Disconnected",
        "tooltip": false, // the panel shows this, and the tooltip would cover it
		"on-click": "~/.config/waybar-widgets/toggle.sh wifi",
		"on-click-right": "foot wpa_cli"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": "󰗾 {icon} {format_source}",
        "format-muted": "󰎊 {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": " ",
        "format-icons": {
            "default": [" ", " ", "  "]
		},
		"on-click": "~/.config/waybar-widgets/toggle.sh volume",
		"on-click-right": "pwvucontrol",
		"tooltip": false
	},
    "custom/date": {
            "format": "{}",
            "interval": 60,
            "exec": "date +'%Y-%m-%d %A %l:%M %p'",
            "on-click": "~/.config/waybar-widgets/toggle.sh date",
            "tooltip": false
        },
    // Bell with the unread count (moon during Do Not Disturb), written by the lock screen shell.
    // Click: Notification Center, right click: Do Not Disturb.
    "custom/notifications": {
            "exec": "cat \"$XDG_RUNTIME_DIR/lockscreen/notifications.json\" 2>/dev/null",
            "return-type": "json",
            "interval": "once",
            "signal": 9,
            "on-click": "qs -p ~/.config/lockscreen ipc call notifications toggle",
            "on-click-right": "qs -p ~/.config/lockscreen ipc call notifications toggleDnd"
        },
    "custom/power": {
            "format": " ",
            "on-click": "~/.config/waybar-widgets/toggle.sh power",
            "on-click-right": "~/.config/waybar/session-menu.sh",
            "tooltip": false
        },
	"custom/profile": {
		"format": "{}",
		"interval": 2,
		"exec": "cat /sys/firmware/acpi/platform_profile",
		"tooltip": false
		},
	"custom/spotify": {
		"exec": "~/.config/waybar/mediaplayer.py --player spotify",
		"format": "{}  ",
		"return-type": "json",
		"on-click": "playerctl play-pause",
		"on-scroll-up": "playerctl next",
		"on-scroll-down": "playerctl previous"
	},

    "mpd": {
        "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{title} ({elapsedTime:%M:%S}/{totalTime:%M:%S})",
        "format-disconnected": "Disconnected ",
        "format-stopped": "",
        "unknown-tag": "N/A",
        "interval": 2,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "on-click": "mpc toggle",
        "on-click-right": "mpc repeat",
        "on-click-middle": "mpc stop",
        "on-scroll-up":"mpc next",
        "on-scroll-down":"mpc prev",
        "tooltip-format": "MPD (connected), {artist} - {album} - {title} ⸨{songPosition}/{queueLength}⸩",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },


}
